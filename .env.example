OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Free local LLM alternative (no API key required)
# Set LLM_PROVIDER=ollama to use local Llama instead of OpenAI
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
DATABASE_URL=postgresql://omniagent:password@postgres:5432/omniagent
REDIS_URL=redis://redis:6379
SECRET_KEY=change-this-in-production
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=10
SANDBOX_TIMEOUT=30
